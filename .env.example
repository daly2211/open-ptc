# REST API server port (/tree, /signatures, /exec).
API_SERVER_PORT=9730
# API base URL used by standalone MCP server mode (src/servers/mcp-server.ts).
API_SERVER_URL=http://localhost:9730

# MCP HTTP server port for external MCP clients.
MCP_SERVER_PORT=9731

# WebSocket server port for bidirectional tool-calling clients.
WS_SERVER_PORT=9733

# Open-PTC proxy port (/v1/responses).
PROXY_PORT=9734

# LiteLLM base URL used by the proxy when forwarding model requests.
LITELLM_URL=http://localhost:4001
# LITELLM_URL=http://litellm:4001 # When running in Docker.

# (optional) External API keys to be used by the proxy inside Litellm (litellm_config.yaml). 
OPEN_ROUTER_API_KEY="<your_open_router_api_key>"



# Deno Isolate execution timeout in milliseconds.
# Long-running user code is terminated after this duration.
CODE_EXECUTION_TIMEOUT_MS=30000 # 30 seconds

# Small batching window (ms) for grouping rapid runtime tool calls in proxy flow.
TOOL_CALL_BATCH_WINDOW_MS=10

# Proxy logger verbosity. Valid values: trace, debug, info, warn, error.
PROXY_LOG_LEVEL=info

# Optional: variables referenced by ${VAR_NAME} placeholders in mcp_config.json
# Add keys here that your MCP server URLs/headers require.
