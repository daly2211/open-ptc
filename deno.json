{
  "type": "module",
  "imports": {
    "@mcp/sdk": "npm:@modelcontextprotocol/sdk@^1.20.2",
    "json-schema-to-typescript": "https://esm.sh/json-schema-to-typescript?target=esnext",
    "@yieldray/json-rpc-ts": "jsr:@yieldray/json-rpc-ts@^0.2.2",
    "ajv": "npm:ajv@^8.12.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.2",
    "mcp-lite": "npm:mcp-lite@^0.10.0",
    "openai": "npm:openai@^4.0.0",
    "zod": "npm:zod@^3.22.4",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.23.5",
    "hono": "npm:hono@^4.12.2",
    "@/": "./src/"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "tasks": {
    "start": "run --allow-all src/server.ts",
    "dev": "run --allow-all --watch src/server.ts"
  }
}
