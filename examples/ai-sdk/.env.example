# WebSocket URL used to connect to Open-PTC WS server 
WS_SERVER_URL=ws://localhost:9733

# OpenAI-compatible API endpoint
BASE_URL=https://api.openai.com/v1

# API key resolution order in example.ts:
#   1) API_KEY
#   2) OPENAI_API_KEY
# At least one should be set.
# API_KEY=<your_api_key>
# OPENAI_API_KEY=<your_openai_api_key>

# Model config used by createOpenAI()
MODEL_NAME=gpt-5.2-chat

# Model API mode: chat | responses | completion
MODEL_API=chat
