# WebSocket URL used by code_executor() to connect to Open-PTC WS server
WS_SERVER_URL=ws://localhost:9733

# LangGraph model selection
MODEL_NAME=gpt-4
MODEL_PROVIDER=openai

# Optional OpenAI-compatible endpoint override (LiteLLM/proxy/etc)
# BASE_URL=https://openrouter.ai/api/v1

# Optional explicit API key passed into init_chat_model(api_key=...)
# API_KEY=<your_api_key>

# Optional provider fallback key (used by provider SDKs when API_KEY is unset)
# OPENAI_API_KEY=<your_openai_api_key>
